# Operation Types: Query, Mutation, Subscription
type Query {
    books: [Book!]!
    book(id: Int!): Book!
}

type Mutation {
    addBook(bookInput: BookInput): Book!
}

type Book {
    id: ID!
    title: String!
    author: Author!
}

type Author {
    id: ID!
    name: String!
    books: [Book!]!
}


# these are all output types
# what about input types
input BookInput {
    title: String!
    authorId: Int!
}
